# ---- Application ----------------------------------------------------------
NODE_ENV=development
# Public origin of the site (used for canonical URLs, sitemap, OG, auth callbacks, email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Authentication (Better Auth) -----------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# REQUIRED in production (32+ chars, random; placeholder text is rejected). Left unset, dev uses a built-in dev-only secret.
# BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---- Persistence ----------------------------------------------------------
# Directory for the JSON-file "database". Seeded from src/lib/db/seed on first boot (npm run seed:reset to start over).
DATA_DIR=data/runtime
# Directory for admin image uploads (served from /uploads)
UPLOAD_DIR=public/uploads

# ---- Payments -------------------------------------------------------------
# mock | stripe (stripe is a documented adapter slot, not enabled)
PAYMENT_PROVIDER=mock
# The mock provider is refused in production unless ALLOW_MOCK_PAYMENTS=true (demos only).
# ALLOW_MOCK_PAYMENTS=false
# Signs webhooks and 3-D-Secure action tokens. REQUIRED in production: 32+ random chars, placeholder text is rejected.
# PAYMENT_WEBHOOK_SECRET=
# Artificial latency of the mock gateway in milliseconds (0 disables it)
MOCK_PAYMENT_LATENCY_MS=350
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---- Email ----------------------------------------------------------------
# outbox = write JSON files (html + text) to OUTBOX_DIR, no real SMTP; browse them in /admin/emails
EMAIL_PROVIDER=outbox
EMAIL_FROM="APEXLINE Auto Parts <orders@apexline.example>"
# Defaults to the folder next to DATA_DIR (data/outbox)
# OUTBOX_DIR=data/outbox

# ---- Operations -----------------------------------------------------------
LOG_LEVEL=info
# Set to "true" behind a trusted reverse proxy that overwrites X-Forwarded-For. Without it all visitors share one
# rate-limit / login-lockout bucket.
TRUST_PROXY=false

# ---- Production first boot ------------------------------------------------
# An empty DATA_DIR in production is seeded with catalogue + settings and ONE administrator (no demo people).
# ADMIN_EMAIL=owner@your-shop.example
# ADMIN_PASSWORD=            # 12+ characters; when unset a random password is printed once to the log
# Seed the full demo set (demo customers, orders, public demo credentials) even in production. Demos only.
# SEED_DEMO_DATA=false
