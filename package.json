{
  "name": "apexline-auto-parts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "messages": "node scripts/build-messages.mjs",
    "messages:check": "node scripts/build-messages.mjs --check",
    "messages:watch": "node scripts/build-messages.mjs --watch",
    "docs:arch": "node scripts/build-architecture.mjs",
    "brand:assets": "tsx scripts/generate-brand-assets.ts",
    "predev": "npm run messages",
    "dev": "next dev",
    "prebuild": "npm run messages",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "seed:reset": "tsx --conditions=react-server scripts/seed-reset.ts",
    "art:products": "tsx --conditions=react-server scripts/generate-product-art.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "better-auth": "^1.7.7",
    "clsx": "^2.1.1",
    "lucide-react": "^1.54.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
